{
  "consumer": {
    "name": "NotificationService"
  },
  "messages": [
    {
      "contents": {
        "currency": "EUR",
        "customerId": "cust-1",
        "lines": [
          {
            "quantity": 2,
            "sku": "SKU-COFFEE",
            "unitPriceCents": 899
          }
        ],
        "orderId": "11111111-1111-1111-1111-111111111111",
        "placedAt": "2026-09-01T08:00:00+00:00",
        "totalCents": 3048
      },
      "description": "an order placed event",
      "matchingRules": {
        "body": {
          "$.currency": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.customerId": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.lines": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type",
                "min": 1
              }
            ]
          },
          "$.lines[*].quantity": {
            "combine": "AND",
            "matchers": [
              {
                "match": "integer"
              }
            ]
          },
          "$.lines[*].sku": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.lines[*].unitPriceCents": {
            "combine": "AND",
            "matchers": [
              {
                "match": "integer"
              }
            ]
          },
          "$.orderId": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.placedAt": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.totalCents": {
            "combine": "AND",
            "matchers": [
              {
                "match": "integer"
              }
            ]
          }
        }
      },
      "metadata": {
        "contentType": "application/json"
      },
      "providerStates": [
        {
          "name": "an order has been placed"
        }
      ]
    }
  ],
  "metadata": {
    "pactRust": {
      "ffi": "0.4.27",
      "models": "1.2.8"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "OrderService"
  }
}